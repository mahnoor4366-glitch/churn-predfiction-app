# Slim image for free hosts (Render, Railway, Hugging Face): SQLite database, no SQL Server driver, no shap.
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY requirements-free.txt .
RUN pip install --no-cache-dir -r requirements-free.txt
COPY . .
ENV BACKGROUND_START=1 LIGHT_TRAIN=1 SYNTHETIC_ROWS=3000 PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
